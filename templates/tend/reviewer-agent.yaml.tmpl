schema_version: '1'
system_prompt:
  path: ../prompts/reviewer-system.md
model:
  provider: {{agent_provider}}
  api: {{agent_api}}
  model_name: {{reviewer_agent_model}}
  settings:
    reasoning:
      effort: {{reviewer_effort}}
    max_output_tokens: {{max_output_tokens}}
tools:
  # `bash` is unrestricted here because the reviewer runs git and the gate over the
  # branch and greps the audited repositories. That material is third-party: the
  # system prompt tells the reviewer it is data and never instructions, and the run
  # host should be a box you can throw away.
  enabled:
    - ls
    - read_file
    - grep
    - glob
    - bash
output:
  tool_name: final_result
  schema_name: review_verdict
  required: true
