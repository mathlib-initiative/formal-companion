# tend orchestrator config for locate run {{run_id}} (preset {{preset}}).
# Generated by cf plan-locate — edit the workspace, not this file.
entrypoint: {{entrypoint}}
worker_agent_command:
  argv:
    - {{tend_root}}/bin/worker-agent.sh
  resume_argv:
    - --resume
reviewer_agent_command:
  argv:
    - {{tend_root}}/bin/reviewer-agent.sh
  resume_argv:
    - --resume
workspace_mirror:
  enabled: false
  reflink_mode: auto
  existing_path_policy: skip
  exclude_names: []
  exclude_paths: []
  symlink_paths: []
# The locate gate lives OUTSIDE the entrypoint and outside every worktree, like the
# findings gate. --changed-files refuses any contribution that touched a path other
# than its own findings/<task>/<source>.json and tasks/<task>.yaml, and the gate
# validates only the documents that contribution changed.
validation_commands:
  - argv: [python3, {{gate_dir}}/{{gate_script}}, --gate-config, {{gate_dir}}/gate.json, --changed-files, --base, {{merge_target_branch}}]
pre_merge_validation_commands:
  - argv: [python3, {{gate_dir}}/{{gate_script}}, --gate-config, {{gate_dir}}/gate.json, --changed-files, --base, {{merge_target_branch}}]
merge_target_branch: {{merge_target_branch}}
merge_validation_worktree: true
seed_worktree_build: false
batched_merge: true
skip_build_validation_for_task_only_merges: false
max_concurrent_worker_agents: {{max_workers}}
max_concurrent_reviewer_agents: {{max_reviewers}}
budget:
  currency: USD
agent_oom_score_adj: 750
cleanup_closed_worktrees: true
