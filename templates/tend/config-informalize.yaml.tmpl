# tend orchestrator config for informalize run {{run_id}} (phase {{phase}} of {{informalize_id}}).
# Generated by cf plan-informalize — edit informalize.yaml or the workspace, not this file.
entrypoint: {{entrypoint}}
worker_agent_command:
  argv:
    - {{tend_root}}/bin/worker-agent.sh
  resume_argv:
    - --resume
reviewer_agent_command:
  argv:
    - {{tend_root}}/bin/reviewer-agent.sh
  resume_argv:
    - --resume
workspace_mirror:
  enabled: false
  reflink_mode: auto
  existing_path_policy: skip
  exclude_names: []
  exclude_paths: []
  symlink_paths: []
# The informalize gate lives OUTSIDE the entrypoint and outside every worktree, beside its own
# copy of the LaTeX runtime (tex/). --changed-files refuses any contribution that touched a path
# its task does not own, then builds and checks what the task wrote. Only the pre-merge command
# carries --pre-merge: a batch may hold several tasks' contributions, one worktree only its own.
validation_commands:
  - argv: [python3, {{gate_dir}}/{{gate_script}}, --gate-config, {{gate_dir}}/gate.json, --changed-files, --base, {{merge_target_branch}}]
pre_merge_validation_commands:
  - argv: [python3, {{gate_dir}}/{{gate_script}}, --gate-config, {{gate_dir}}/gate.json, --changed-files, --pre-merge, --base, {{merge_target_branch}}]
merge_target_branch: {{merge_target_branch}}
merge_validation_worktree: true
seed_worktree_build: false
batched_merge: true
skip_build_validation_for_task_only_merges: false
max_concurrent_worker_agents: {{max_workers}}
max_concurrent_reviewer_agents: {{max_reviewers}}
budget:
  currency: USD
agent_oom_score_adj: 750
cleanup_closed_worktrees: true
