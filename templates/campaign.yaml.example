# campaign.yaml -- one book, one campaign directory.
#
# Rendered by `cf init <dir> --book <id> --pdf <path> --offset <n> --errata-url <u>`.
# This file is the ONLY place a host, a model, a page offset or a repo path is
# named; no script hard-codes them. The campaign directory is a local git repo
# with no remote: it holds book text, statement tables, the findings corpus and
# the ledgers, none of which belong in the skill repo or in a companion repo.
version: 1

campaign:
  name: {{ campaign_name }}
  created: {{ created }}
  # Every artifact that quotes the book carries book_sha; the edition gate
  # refuses anything pinned to another edition.
  notes: ""

book:
  id: {{ book_id }}
  title: {{ book_title }}
  edition: {{ edition }}
  # The PDF is never copied into the campaign or the skill repo; only its sha256
  # is pinned. Page images rendered from it stay gitignored.
  pdf: {{ pdf_path }}
  sha256: {{ book_sha256 }}
  # printed page = PDF page - offset
  offset: {{ offset }}
  # Fetched live with curl (raw HTML kept). Never summarise a fetch: a
  # summarising fetch dropped a real erratum from the hand-written file.
  errata_url: {{ errata_url }}
  # Item kinds of this book. The strict item grammar accepts only these.
  kinds: {{ kinds }}
  # The chapters under audit. THIS IS THE SCOPE EVERY STAGE READS: `cf pair`,
  # `cf plan-run` and `cf detect-proxies` all narrow to it, so def-coverage
  # means the same thing whichever command wrote it. Empty = the whole book
  # (Tao ch.1 has 36 Definitions; the whole book has 40, which is why an
  # unscoped run and a scoped one disagreed by 3 bridge-only + 1 missing).
  chapters: {{ chapters }}
  # What to do with items nobody formalises: report_coverage | ignore
  remark_policy: report_coverage

# Filled by `cf onboard <name> --repo <path> --adapter <kind>`.
# name, repo, adapter, owner, write_policy (read_only | branch_only | branch_and_pr)
companions: []

hosts:
  # `cf run` REFUSES any host that is not listed here, and requires
  # --i-have-consent (recorded in run.yaml). Running a fleet copies private Lean
  # sources and copyrighted book text to the host: the box owner must agree.
  allowlist: []
  agentbox_profile: null
  remote_root: null

models:
  # Never Fable for subagents: Fable-default fleets lost agents to the session
  # limit mid-run. Worker/reviewer ids must be confirmed by a 1/1 smoke test.
  worker: claude-sonnet-5
  reviewer: claude-opus-5
  skeptic: claude-opus-5
  adjudicator: claude-opus-5
  # Second opinion for the calibration pair (agentbox host codex).
  calibration: null

defaults:
  # def-coverage -> attack presets -> differential -> adjudicate -> route -> report
  mode: attack:vac
  book_access: text            # text | text+images
  max_concurrent_workers: 8
  max_concurrent_reviewers: 5
  max_repos_per_task: 4        # k>4 companions split into reference + peers
  local_fleet_max_items: 100   # above this, the run belongs on the server
  gate_out_of_tree: true       # the gate never runs from the tree the worker edits
  worktree_budget_gb: 8        # tend makes a worktree per ready task

budget:
  billing_path: subscription   # subscription | api_gateway
  max_cost_usd: null
  require_consent: true

policy:
  # Nothing leaves the campaign directory while _meta.status is UNCHALLENGED.
  publish_unchallenged: false
  # Exports replace book_quote with (page, normalised hash) unless turned off.
  redact_quotes_on_export: true
  # `cf init` installs a pre-push hook; the campaign repo has no remote.
  allow_remote: false
