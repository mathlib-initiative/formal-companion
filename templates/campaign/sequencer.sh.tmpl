#!/usr/bin/env bash
# Generated by `cf campaign render` for campaign {{campaign_id}} on host alias {{host}}.
# Regenerate rather than edit: campaign.yaml records the sha of what was rendered.
#
# The host-side sequencer of docs/proposals/wikipedia-locate.md section 6: it runs
# the shards of one locate campaign in order -- shard k+1 starts when shard k's
# `tend run` ends -- with the model-free spend watchdog beside each, exports the
# shard's usage and prunes its transcripts, and STOPS the campaign the moment a
# watchdog drains a shard (spend past the shard's recorded cap, or a gate-failure
# rate or cost per merged task past {{multiple}} x the pilot's p90). Nothing here
# needs cflib; the operator's machine only harvests the receipts.
#
# Every shard must already be transferred and smoke-tested with `cf run` (its
# own consent, allowlist and 1/1 smoke test); this script launches nothing that
# `cf run --stage transfer` did not place.
#
# Environment:
#   CF_TEND_CMD          the shell prefix tend runs under (default: the host's tend_cmd)
#   CF_TRANSCRIPT_DIRS   colon-separated transcript directories to export and prune
#                        per shard (unset: usage is not exported, nothing is pruned)
#   CF_WATCH_INTERVAL    seconds between watchdog checks (default 300)
set -uo pipefail

STATE="{{state_dir}}"
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TEND_DEFAULT={{tend_cmd_quoted}}
TEND="${CF_TEND_CMD:-$TEND_DEFAULT}"
INTERVAL="${CF_WATCH_INTERVAL:-300}"
mkdir -p "$STATE"
# tend's prefix is shell (it may export PATH and cd), so it runs through bash -c
run_tend() { local cmd="$TEND" a; for a in "$@"; do cmd+=" $(printf '%q' "$a")"; done; bash -c "$cmd"; }
log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$STATE/sequencer.log" >&2; }

export_usage() {   # <shard index> <started marker>
  [ -n "${CF_TRANSCRIPT_DIRS:-}" ] || { log "shard $1: CF_TRANSCRIPT_DIRS unset; usage not exported"; return 0; }
  IFS=: read -r -a dirs <<<"$CF_TRANSCRIPT_DIRS"
  if python3 "$HERE/usage.py" "${dirs[@]}" --export "$STATE/usage-$1.jsonl" >>"$STATE/sequencer.log" 2>&1; then
    # prune only what this shard wrote, and only once its usage is exported
    for d in "${dirs[@]}"; do
      [ -d "$d" ] && find "$d" -type f -name '*.jsonl' -newer "$2" -delete
    done
    log "shard $1: usage exported to $STATE/usage-$1.jsonl; its transcripts pruned"
  else
    log "shard $1: usage export FAILED; transcripts kept (they age out after about thirty days)"
  fi
}

run_shard() {   # <index> <run id> <tend root> <entrypoint> <max cost> <workers> <reviewers>
  local index="$1" run="$2" root="$3" entrypoint="$4" cap="$5" workers="$6" reviewers="$7"
  if [ -e "$STATE/shard-$index.done" ]; then log "shard $index ($run): done already"; return 0; fi
  [ -d "$root" ] || { log "shard $index ($run): no tend root at $root; transfer it with cf run first"; return 1; }
  touch "$STATE/shard-$index.started"
  rm -f "$root/watchdog.stop" "$root/watchdog.json"
  python3 "$HERE/watchdog.py" --root "$root" --entrypoint "$entrypoint" --max-cost "$cap" \
    {{watchdog_flags}} --tend "$TEND" --interval "$INTERVAL" >>"$root/watchdog.out" 2>&1 &
  local watchdog=$!
  log "shard $index ($run): tend run at $workers workers / $reviewers reviewers, cap \$$cap"
  run_tend tend run --root "$root" --log-level INFO \
    --max-concurrent-worker-agents "$workers" --max-concurrent-reviewer-agents "$reviewers" \
    >>"$root/run.log" 2>&1 </dev/null
  local rc=$?
  touch "$root/watchdog.stop"
  kill "$watchdog" 2>/dev/null; wait "$watchdog" 2>/dev/null
  python3 "$HERE/watchdog.py" --root "$root" --entrypoint "$entrypoint" --max-cost "$cap" \
    {{watchdog_flags}} --tend "$TEND" --once --dry-run >>"$root/watchdog.out" 2>&1
  export_usage "$index" "$STATE/shard-$index.started"
  if grep -q '"drained": true' "$root/watchdog.json" 2>/dev/null; then
    log "shard $index ($run): DRAINED by the watchdog; the campaign stops here for the operator"
    touch "$STATE/STOPPED"
    return 2
  fi
  [ "$rc" = 0 ] || { log "shard $index ($run): tend run exited $rc; the campaign stops"; return "$rc"; }
  touch "$STATE/shard-$index.done"
  log "shard $index ($run): done"
}

[ -e "$STATE/STOPPED" ] && { log "campaign {{campaign_id}} is STOPPED; remove $STATE/STOPPED to resume"; exit 2; }
{{shard_lines}}
log "campaign {{campaign_id}}: every shard done"
