   {"item": "<item>", "target": "absence", "action": "uphold",
    "queries": ["<query a>", "<query b>", "<query c>"],
    "query_clauses": {"<query a>": ["c1"], "<query b>": ["c2"], "<query c>": ["c1", "c2"]},
    "witness": "<what you searched, and why nothing states a clause>"},
   {"item": "<item>", "target": "coverage", "action": "confirm",
    "part_clauses": {"<a part's location_key>": ["c1"], "<another's>": ["c2"]},
    "witness": "<the part that states each clause>"},
   {"item": "<item>", "target": "coverage", "action": "refute",
    "witness": "<the clause no part states, or the hypothesis a part adds>"},
   {"item": "<item>", "target": "scope", "action": "uphold", "witness": "<why>"},
   {"item": "<item>", "target": "prominence", "action": "overturn", "prominence": "central",
