{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:formal-companion:overlay-config-v1",
  "title": "formal-companion overlay configuration, version 1",
  "description": "Section 3 of the overlay contract. The identifier above names this schema and is never fetched. The authoritative implementations are scripts/overlay/config.py in the formal-companion skill and tools/check_generated.py beside this file; they repeat these four patterns verbatim and a test fails when a string differs. A loopback host is written 127.x.y.z or ::1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "source_id", "title", "pdf", "site"],
  "properties": {
    "schema": {"const": "formal-companion/overlay-config"},
    "schema_version": {"const": 1},
    "source_id": {
      "description": "The PDF the overlay shows: the source_id in its records' overlay extension.",
      "type": "string",
      "minLength": 1
    },
    "title": {"type": "string", "minLength": 1},
    "lede": {"type": "string", "minLength": 1},
    "back_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href", "text"],
      "properties": {
        "href": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strip_prefix": {
          "description": "A declaration-name prefix the cards hide; the empty string hides nothing.",
          "type": "string"
        }
      }
    },
    "storage_key": {"type": "string", "minLength": 1},
    "pdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name"],
      "properties": {
        "file_name": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$"},
        "cache_dir": {"$ref": "#/$defs/relative_path"},
        "route": {
          "description": "Starts with /__, names a file, holds no `..`. Defaults to /__overlay_pdf__/<file_name>.",
          "type": "string",
          "pattern": "^/__[A-Za-z0-9._~/-]*[A-Za-z0-9._~-]$",
          "not": {"pattern": "\\.\\."}
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_root": {"$ref": "#/$defs/relative_path"},
        "index": {"$ref": "#/$defs/relative_path"},
        "mount": {"$ref": "#/$defs/relative_path"},
        "link_text": {"type": "string", "minLength": 1}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "description": "Each entry is one argv, run with no shell. The default is no command at all.",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "not": {"pattern": "\\x00"}}
          }
        }
      }
    },
    "serve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "description": "A loopback address: 127.0.0.0/8 or ::1.",
          "type": "string",
          "pattern": "^(127\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){2}|::1)$"
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  },
  "$defs": {
    "relative_path": {
      "description": "A normalised, traversal-free path inside the companion: no leading slash, no empty, `.` or `..` segment, no trailing slash, no backslash and no control character.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\x00-\\x1f\\\\][^\\x00-\\x1f\\\\]*$",
      "not": {
        "anyOf": [
          {"pattern": "/$"},
          {"pattern": "//"},
          {"pattern": "(^|/)\\.{1,2}(/|$)"}
        ]
      }
    }
  }
}
