# workspace.yaml -- N companions, M sources.
#
# Rendered by `cf init <dir>`, which takes NO source flags: a source is
# discovered by `cf onboard <repo>`, which reads the repo, fingerprints the PDF
# bytes and infers the page offset, the item kinds and the errata page. If you
# find yourself typing an offset or an errata URL here, discovery failed and
# said so -- fix that rather than filling this in by hand.
#
# This file is the ONLY place a host, a model, a page offset or a repo path is
# named; no script hard-codes them. The workspace directory is a local git repo
# with no remote: it holds source text, statement tables, the findings corpus
# and the ledgers, none of which belong in the skill repo or in a companion.
version: 2

workspace:
  name: {{ workspace_name }}
  created: {{ created }}
  notes: ""

# Filled by `cf onboard <repo>`. One entry per companion:
#   repo, adapter, sources[], anchor_source, bundled_sources[], owner,
#   write_policy (read_only | branch_only | branch_and_pr), discovered{}
#
# `sources` is the list this companion is audited against -- a companion may be
# bound to more than one. `anchor_source` is the edition whose PAGINATION its
# page anchors follow, which is NOT always an edition it ships: tao-measure-lean
# bundles the 2011 draft and anchors to the published book, and mistaking the one
# for the other is what made 22 of 40 batch-1 findings pagination noise.
companions: {}

# Filled by `cf onboard` / `cf sources add`, keyed by source_id and identified by
# the sha256 of the PDF BYTES. The PDF is never copied into the workspace or the
# skill repo; only its sha is pinned, and page images rendered from it stay
# gitignored.
#
#   offset             printed page = PDF page - offset
#   offset_confidence  < 0.9 means a human had to say so (`cf sources set`)
#   kinds              the item kinds THIS source's headings actually use
#   chapters           the audited scope, derived from what the companions tag
#   role               audited | reference (reference is prepared for the page
#                      map only and audited by nobody)
#   confirmed          false = discovered, nobody has checked it (`cf status`)
#
# What a source was ALREADY known to be is remembered in the skill's
# registry/sources.yaml, and anything new discovery learns is appended to this
# workspace's own registry.yaml overlay with confirmed: false. Neither file ever
# holds a line of the book: see registry/README.md.
sources: {}

hosts:
  # `cf run` REFUSES any host that is not listed here, and requires
  # --i-have-consent (recorded in run.yaml). Running a fleet copies private Lean
  # sources and copyrighted source text to the host: the box owner must agree.
  allowlist: []
  agentbox_profile: null
  remote_root: null

models:
  # Never Fable for subagents: Fable-default fleets lost agents to the session
  # limit mid-run. Worker/reviewer ids must be confirmed by a 1/1 smoke test.
  worker: claude-sonnet-5
  reviewer: claude-opus-5
  skeptic: claude-opus-5
  adjudicator: claude-opus-5
  # Second opinion for the calibration pair (agentbox host codex).
  calibration: null

defaults:
  # def-coverage -> attack presets -> differential -> adjudicate -> route -> report
  mode: attack:vac
  source_access: text          # text | text+images
  max_concurrent_workers: 8
  max_concurrent_reviewers: 5
  # HARD account limit (references/traps.md C3): past 16 concurrent sessions the
  # API returns 409s, per ACCOUNT, across workspaces. workers + reviewers must
  # stay under it; `cf run` refuses more without --over-session-cap.
  max_concurrent_sessions: 16
  max_repos_per_task: 4        # k>4 companions split into reference + peers
  local_fleet_max_items: 100   # above this, the run belongs on the server
  gate_out_of_tree: true       # the gate never runs from the tree the worker edits
  worktree_budget_gb: 8        # tend makes a worktree per ready task

budget:
  billing_path: subscription   # subscription | api_gateway
  max_cost_usd: null
  require_consent: true

policy:
  # Nothing leaves the workspace directory while _meta.status is UNCHALLENGED.
  publish_unchallenged: false
  # Exports replace book_quote with a hash of the normalised sentence unless this
  # is turned off: `cf route --redact-quotes` records (raw length, sha256) and
  # `cf share export` records (page, normalised length, sha256, first/last six
  # words), from which `cf quotes hydrate` recovers the text on a machine that
  # already holds that edition.
  redact_quotes_on_export: true
  # false is the control: `cf init` REFUSES a workspace repo that has a remote,
  # and `cf status` reports one that appears later. The pre-push hook it installs
  # is a reminder on top of that -- `git push --no-verify` skips it -- and
  # `cf init --no-remote-guard` is the stronger, optional local-config guard.
  allow_remote: false
  # false forbids `cf onboard --download` outright. Even when true, a download
  # happens only with the flag AND a registry licence note saying the author
  # publishes the file himself. Nothing is ever redistributed.
  allow_download: false
  # true makes `cf plan-run` refuse a source whose `confirmed` is still false.
  require_confirmed_sources: false
  # An errata URL from a CONFIRMED registry entry (or one typed with
  # `cf sources set`) is fetched without asking. A URL harvested from a
  # companion repo's own files is not, unless this is true or `cf onboard
  # --fetch-errata` says so once: the repo would otherwise choose both an
  # outbound request from this machine and a block of text that reaches the
  # workers as authoritative errata.
  allow_errata_fetch: false

# Where `cf onboard` may look for a PDF a repo names but does not commit,
# searched after the paths the repo itself names, the repo's own caches and this
# workspace's sources/ store. Matched by sha when one is known, by filename or
# title otherwise.
#
# This list is also the ALLOWLIST for an absolute or `~` path a companion repo
# names in its own files: a hint that lands outside the repo, this workspace's
# sources/ store and these roots is reported and never opened. So it is only
# ever added to deliberately -- the earlier default handed two home-directory
# subtrees to every audited repo, and only resolved on one machine's layout.
#
# `cf init` adds nothing but ~/Downloads. The roots DERIVED from what this
# workspace already holds are searched as well without being listed here: its own
# sources/ store, and for the parent directory <p> of every onboarded companion
# repo, `<p>/**/sources` and `<p>/**/.lake/official-pdf` -- the two places a
# companion's PDF actually sits, never the bare <p>, which for a checkout kept on
# the desktop would be the whole desktop. `cf init` and `cf doctor` print the
# effective set. Add a root with `cf sources add <pdf> --for <companion>`, or by
# editing this list.
library_paths:
  - ~/Downloads
